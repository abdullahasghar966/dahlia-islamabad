# Normalise to LF in the repository, check out native on each platform.
# Without this, a Windows checkout commits CRLF and every file looks changed
# to a collaborator on macOS/Linux (and to Vercel's Linux build).
* text=auto eol=lf

# Windows-only helper scripts must keep CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary — never touch these.
*.woff2 binary
*.woff binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
